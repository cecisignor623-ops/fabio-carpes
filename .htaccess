# Desabilita cache para HTML (sempre buscar versão fresca)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Desabilita LiteSpeed cache para HTML
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# Mantém cache para assets estáticos (imagens, fontes, css, js)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|css|js)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# Compressão Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
